# LLM provider settings
LLM_API_KEY=your-openai-api-key-here
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_MAX_TOKENS=512

# Postgres connection (matches docker-compose defaults)
DATABASE_URL=postgresql://datacopilot:datacopilot@postgres:5432/datacopilot

# Local object storage root (inside the container, mapped via volume mount)
STORAGE_ROOT=/app/storage

# RAG retrieval method: keyword | pgvector
RETRIEVAL_METHOD=keyword

# Embedding model for pgvector indexing and retrieval (must produce 1536-dim vectors)
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
